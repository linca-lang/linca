// Linca test case | spec 0.1 | section 8
// Two relations between the same pair of models need names.

model User {
  id: Uuid @primary
  authored: List<Post>
  reviewed: List<Post>
}

model Post {
  id: Uuid @primary
  authorId: Uuid
  reviewerId: Uuid
  author: User @relation(fields: [authorId])    //~ E0502
  reviewer: User @relation(fields: [reviewerId])
}
