// Linca test case | spec 0.1 | section 17.4
// An error is not a type: not a field type, a parameter type, a result type or the source of a view.

error NotFound {
  resource: String
}

record Detail {
  resource: String
}

record Wrapper {
  failure: Detail
}

view Copy = Detail

service Reports {
  report(failure: Detail)
  load() -> Detail throws NotFound
}
